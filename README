# Creating HiPS file from HEALPix file (myhealpix.fits) generated with FREMI Tools:

$ java -jar HiPSgen.jar in=./myhealpix.fits out=./hipsout/ creator_did=fab



# Once the HiPS has been created move to the ROOT directory of the HiPS
$ cd /Users/fabriziogiordano/Desktop/PhD/code/fermi/hipsgen/hipsout/UNK.AUTH_P_fab

# Run node server to serve the HiPS through HTTP
$ npx serve --cors

# Open the browser to http://localhost:3000/


